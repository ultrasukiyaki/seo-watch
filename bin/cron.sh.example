#!/bin/sh
set -eu

# このファイルを cron.sh などの名前へコピーして使用します。
# APP_DIRはこのスクリプトの1階層上を自動判定します。
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

# 通常はPATH上のphpを利用します。共有サーバーでPHPのフルパス指定が必要な場合は、
# cron側の環境変数または次の行を編集してください。
PHP_BIN=${PHP_BIN:-php}
IMPORT_DAYS=${IMPORT_DAYS:-3}

exec "$PHP_BIN" "$APP_DIR/bin/import.php" --days="$IMPORT_DAYS"
